# --- Konfigurasi Ngrok Tunnel (Jalan Otomatis di Container) ---
NGROK_URL=https://stinging-usual-risotto.ngrok-free.dev
NGROK_AUTHTOKEN=3H5HraogcidhEkQvES4bB16dBmP_2famCtzKyuJTtoJPojLGN

# --- Xendit Payment Gateway (Invoice API Sandbox) ---
# Dashboard Xendit > Settings > Developers > API Keys (Mode Test: xnd_development_...)
